# NutriMind AI — Backend Environment Variables
# Copy this file to .env and adjust for your local setup.
# NEVER commit the real .env file to version control.

APP_NAME=NutriMind AI

APP_ENV=development

DEBUG=true

API_V1_PREFIX=/api/v1

BACKEND_HOST=0.0.0.0

BACKEND_PORT=8000

CORS_ORIGINS=http://localhost:3000

PASSWORD_HASHING_SCHEMES=argon2

DATABASE_URL=postgresql+asyncpg://nutrimind:change_this_in_real_environments@localhost:5432/nutrimind

JWT_SECRET_KEY=replace_with_a_long_random_secret_for_real_environments
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=nutrimind-ai
JWT_AUDIENCE=nutrimind-ai-api

REFRESH_TOKEN_SECRET_KEY=replace_with_another_long_random_secret

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

USDA_API_KEY=

GROQ_API_KEY=
